<?xml version="1.0" encoding="utf-8"?>
<!--
  Inventor add-in manifest for ThreadModeler.
  Supported: Inventor 2026 (Update 2026.4 or later, .NET 10 runtime) and Inventor 2027.
  Inventor 2026 = version 30, Inventor 2027 = version 31.
-->
<Addin Type="Standard">
  <ClassId>{90f6009a-a2ed-400f-9cbd-cee55ad30d23}</ClassId>
  <ClientId>{90f6009a-a2ed-400f-9cbd-cee55ad30d23}</ClientId>
  <DisplayName>coolOrange - ThreadModeler</DisplayName>
  <Description>coolOrange Inventor ThreadModeler plug-in</Description>
  <!-- Path is relative to this .addin file. -->
  <Assembly>ThreadModeler.dll</Assembly>
  <LoadOnStartUp>1</LoadOnStartUp>
  <UserUnloadable>1</UserUnloadable>
  <Hidden>0</Hidden>
  <SupportedSoftwareVersionGreaterThan>29..</SupportedSoftwareVersionGreaterThan>
  <DataVersion>1</DataVersion>
  <UserInterfaceVersion>1</UserInterfaceVersion>
  <LoadBehavior>0</LoadBehavior>
  <!--
    Inventor 2027+: 1 = load into Inventor's shared assembly context, so the add-in binds to the same
    Autodesk.Inventor.Interop as Inventor itself. (0 = isolated context; it would load a second copy of
    the interop, and Inventor could not cast the add-in to its ApplicationAddInServer type.)
    Earlier releases ignore this element.
  -->
  <UseInventorAssemblyContext>1</UseInventorAssemblyContext>
</Addin>
