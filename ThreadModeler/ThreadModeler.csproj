<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ThreadModeler Inventor add-in.
    Target: Autodesk Inventor 2026 (Update 2026.4 or later) and Inventor 2027, both of which host
    add-ins on .NET 10. See docs/BUILDING.md and docs/MIGRATION.md.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ThreadModeler</RootNamespace>
    <AssemblyName>ThreadModeler</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <!-- Required for assemblies that are loaded as plug-ins into another .NET host (Inventor). -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Assembly attributes come from ..\ProductInfo.cs and Properties\AssemblyInfo.cs. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Lets the project be compiled on non-Windows build machines (CI / Linux). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Icons/bitmaps in .resx files are stored pre-serialized (no BinaryFormatter, which is gone in .NET 9+). -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\bin\$(Configuration)\Contents\</OutputPath>
    <!-- Legacy code base: keep the build output readable. -->
    <NoWarn>$(NoWarn);CA1416;SYSLIB0003;CS0618;CS0168;CS0169;CS0414;CS0649;CS8981</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <StartAction>Program</StartAction>
    <StartProgram>$(ProgramW6432)\Autodesk\Inventor 2027\Bin\Inventor.exe</StartProgram>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!--
    Inventor interop assembly. Interop types are embedded, so the add-in does not depend on a specific
    Inventor interop version. The installed Inventor 2027/2026 interop is used when available, otherwise
    the copy in ..\References (enough for compiling: the add-in uses no API newer than that).
    Override with:  dotnet build -p:InventorInteropPath="C:\path\Autodesk.Inventor.Interop.dll"
  -->
  <PropertyGroup>
    <InventorInteropPath Condition="'$(InventorInteropPath)' == '' And Exists('$(ProgramW6432)\Autodesk\Inventor 2027\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll')">$(ProgramW6432)\Autodesk\Inventor 2027\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll</InventorInteropPath>
    <InventorInteropPath Condition="'$(InventorInteropPath)' == '' And Exists('$(ProgramW6432)\Autodesk\Inventor 2026\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll')">$(ProgramW6432)\Autodesk\Inventor 2026\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll</InventorInteropPath>
    <InventorInteropPath Condition="'$(InventorInteropPath)' == ''">..\References\Autodesk.Inventor.Interop.dll</InventorInteropPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorInteropPath)</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="stdole">
      <HintPath>..\References\stdole.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ProductInfo.cs" Link="Properties\ProductInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ribbon definition and command icons are read through GetManifestResourceStream. -->
    <EmbeddedResource Include="resources\ribbons.xml" />
    <EmbeddedResource Include="resources\Help.ico" />
    <EmbeddedResource Include="resources\about.ico" />
    <EmbeddedResource Include="resources\threadModeler.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Thread Templates\*.ipt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="coolOrange.ThreadModeler.Inventor.addin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ThreadModeler.dll.log4net" CopyToOutputDirectory="PreserveNewest" />
    <None Include="PackageContents.xml" />
    <None Include="ReadMe.txt" />
    <!-- Stray copy of the template that was never shipped. -->
    <None Remove="resources\BSW Template.ipt" />
  </ItemGroup>

</Project>
